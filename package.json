{
  "name": "canalpay",
  "private": true,
  "version": "0.1.0",
  "description": "CanalPay - Pagos para canales rápidos",
  "scripts": {
    "bootstrap": "npm install && cd shared && npm install && cd ../admin && npm install && cd ../mobile && npm install",
    "phase1:apply": "node scripts/phase1-apply-migrations.mjs",
    "phase1:users": "node scripts/phase1-create-users.mjs",
    "mobile:test-user": "node scripts/create-mobile-test-user.mjs",
    "phase1:verify": "node scripts/phase1-verify.mjs",
    "admin": "cd admin && npm run dev",
    "mobile": "cd mobile && npm start",
    "expo:whoami": "node scripts/expo-whoami.mjs",
    "github:auth": "node scripts/github-auth.mjs",
    "expo:link": "cd mobile && npx eas init",
    "build:admin": "cd admin && npm run build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "phase2:setup": "node scripts/phase2-setup-env.mjs",
    "phase2:verify": "node scripts/phase2-verify.mjs",
    "phase3:verify": "node scripts/phase3-verify.mjs",
    "phase4:verify": "node scripts/phase4-verify.mjs",
    "phase5:verify": "node scripts/phase5-verify.mjs",
    "phase6:verify": "node scripts/phase6-verify.mjs",
    "lint": "cd admin && npm run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "15.5.18"
  },
  "devDependencies": {
    "pg": "^8.21.0"
  }
}
